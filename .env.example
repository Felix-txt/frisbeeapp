# Copy to .env and adjust:  cp .env.example .env

# Port on the host machine that nginx should proxy to.
#   proxy_pass http://127.0.0.1:3000;
HOST_PORT=3000

# Which host interface to publish on.
#   127.0.0.1 = local only (default) — nginx is the only way in
#   0.0.0.0   = also reachable directly over your network, e.g. for testing
BIND=127.0.0.1

TZ=Europe/Stockholm
